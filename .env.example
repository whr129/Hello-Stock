TELEGRAM_BOT_TOKEN=
POSTGRES_DB=news_agent
POSTGRES_USER=news_agent
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Supported 4 GB server limits; override only after measuring the host.
POSTGRES_MEMORY_LIMIT=768m
BOT_MEMORY_LIMIT=640m
SCHEDULER_MEMORY_LIMIT=1024m
MIGRATE_MEMORY_LIMIT=512m
# Used only when running the app outside Docker. URL-encode special password characters.
DATABASE_URL=postgresql+asyncpg://news_agent:replace-with-a-long-random-password@localhost:5432/news_agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GENERAL_SEARCH_MODEL=
GENERAL_SEARCH_MAX_SOURCES=5
GENERAL_SEARCH_TIMEOUT_SECONDS=30
MAIN_AGENT_MODEL=
MAIN_AGENT_MAX_TOOL_ITERATIONS=5
RESEARCH_WEB_ENABLED=false
RESEARCH_WEB_MODEL=
RESEARCH_WEB_MAX_COMPANIES=3
RESEARCH_WEB_CONCURRENCY=3
RESEARCH_WEB_MAX_QUERIES_PER_COMPANY=3
RESEARCH_WEB_MAX_SOURCES_PER_COMPANY=6
RESEARCH_WEB_COMPANY_TIMEOUT_SECONDS=25
RESEARCH_WEB_TOTAL_TIMEOUT_SECONDS=60
RESEARCH_WEB_MAX_RETRIES=1
RESEARCH_WEB_NEWS_LOOKBACK_DAYS=7
ANSWER_REFLECTION_ENABLED=true
ANSWER_REFLECTION_MAX_RETRIES=1
RUNTIME_ALERT_TELEGRAM_CHAT_ID=
RUNTIME_RETENTION_DAYS=30
EMBEDDING_MODEL=text-embedding-3-small
NEWS_FETCH_INTERVAL_SECONDS=900
MARKET_REFRESH_INTERVAL_SECONDS=300
RSS_FETCH_TIMEOUT_SECONDS=15
MARKET_FETCH_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=30
SCHEDULER_TICK_SECONDS=60
NEWS_FRESHNESS_HOURS=24
SUMMARY_FRESHNESS_HOURS=24
SNAPSHOT_FRESHNESS_MINUTES=15
ARTICLE_RETENTION_DAYS=30
SNAPSHOT_RETENTION_DAYS=30
MARKET_UNIVERSE_SYMBOLS=SPY,QQQ,DIA,IWM,AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA
SIGNAL_RETENTION_DAYS=30
SIGNAL_ALERT_THRESHOLD=75
SOURCE_HEALTH_MIN_SCORE=35
SIGNAL_MIN_STRONG_EVIDENCE_SOURCES=2
SIGNAL_ALLOW_DEVELOPING_DEFAULT=false
EVIDENCE_LINK_RECHECK_HOURS=24
RESEARCH_REPORT_MAX_EVIDENCE_ITEMS=3
SIGNAL_ALERT_COOLDOWN_MINUTES=360
SIGNAL_WEIGHT_MENTION_VELOCITY=1.0
SIGNAL_WEIGHT_SOURCE_DIVERSITY=1.0
SIGNAL_WEIGHT_RECENCY=1.0
SIGNAL_WEIGHT_SEMANTIC_SIMILARITY=1.0
SIGNAL_WEIGHT_PRICE_MOMENTUM=1.0
SIGNAL_WEIGHT_VOLUME=1.0
SIGNAL_WEIGHT_THEME_PERSISTENCE=1.0
SIGNAL_WEIGHT_TRUST=1.0
SOCIAL_SIGNALS_ENABLED=false
LLM_MENTION_EXTRACTION_ENABLED=false
JOB_RUN_RETENTION_DAYS=30
SHORT_TERM_MEMORY_WINDOW_SIZE=20
SHORT_TERM_MEMORY_EXPIRY_MINUTES=43200
CONVERSATION_EVENT_RETENTION_DAYS=30
LONG_TERM_MEMORY_BATCH_SIZE=20
LONG_TERM_MEMORY_TOP_K=5
MEMORY_CANDIDATES_PER_BATCH=6
MEMORY_JOB_MAX_RETRIES=3
LOG_LEVEL=INFO
